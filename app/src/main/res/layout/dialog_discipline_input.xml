<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_background"> <TextView
    android:id="@+id/dialog_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Adicionar Nova Disciplina"
    android:textSize="20sp"
    android:textColor="@color/Oxford_Blue"
    android:textStyle="bold"
    android:gravity="center"
    android:layout_marginBottom="20dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_layout_discipline_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome da Disciplina"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/Oxford_Blue"
        app:hintTextColor="@color/Oxford_Blue"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_discipline_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="50" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_layout_discipline_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cor da Disciplina (ex: #RRGGBB)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/Oxford_Blue"
        app:hintTextColor="@color/Oxford_Blue"
        android:layout_marginBottom="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_discipline_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLength="7" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>